{
  "schema_version": 1,
  "status": "proposed_not_executed",
  "mask_sensitivity": {
    "probabilities": [0.05, 0.1, 0.15, 0.2, 0.25, 0.3],
    "sensitivity_evaluation_split": "test",
    "main_setting_selection_split": "validation",
    "main_setting_probability": 0.2,
    "main_setting_source": "validation-selected A3 value recorded in experiment workbook sheet 20",
    "reference_ldp": 0.3,
    "candidate_unit": "shared_unique_character_type_absent_from_all_protected_spans",
    "term_protection": "mark_every_character_in_matched_term_spans_then_exclude_any_type_with_a_protected_occurrence",
    "replacement": "replace_every_occurrence_of_selected_types_in_both_texts",
    "rounding_rule": "floor(probability_times_eligible_unique_tokens_plus_0.5)",
    "empty_or_unchanged_view": "exclude_from_unsupervised_loss_and_log_count",
    "test_sweep_peak_is_not_a_validation_selected_parameter": true
  },
  "sentence_length": {
    "measurement": "sum_unicode_character_length_of_two_texts_before_truncation",
    "intervals_left_closed_right_open": [0, 21, 31, 41, 51, null],
    "report_pair_count_and_positive_count": true,
    "reported_metrics": ["accuracy", "macro_f1"],
    "positive_recall_interval": "exact_95_percent_binomial_interval_assuming_independent_pairs"
  },
  "tsne": {
    "role": "descriptive_only",
    "sample_max": 1000,
    "same_sample_ids_across_models": true,
    "input_layer": "pair_representation_before_classification",
    "perplexity": 30,
    "perplexity_must_be_less_than_number_of_samples": true,
    "learning_rate": 200,
    "initialization": "pca",
    "iterations": 1000,
    "random_seed": 42
  },
  "latency": {
    "device": "cpu",
    "batch_size": 1,
    "intraop_threads": 4,
    "single_thread_control": true,
    "warmup_runs": 100,
    "timed_rounds": 5,
    "timed_runs_per_round": 1000,
    "max_characters_per_sentence": 128,
    "report": ["round_mean_ms", "sample_standard_deviation_across_rounds"],
    "includes": "tokenization_and_tensor_construction",
    "excludes": "model_loading_and_first_time_compilation"
  },
  "bootstrap": {
    "resamples": 2000,
    "seed": 20261030,
    "pair_models_on_same_test_units": true,
    "resample_unit": "independent_source_or_sentence_group_when_available"
  }
}
